# SANITA Production Environment Secrets
PORT=8080
NODE_ENV=production

# Cryptographic Keys (Use high entropy 256-bit keys)
SANITA_AES_KEY=sanita-enterprise-aes-32byte-key!
SANITA_HMAC_SECRET=sanita-tamper-proof-hmac-key-2026
JWT_SECRET=sanita-super-secret-anti-breach-token-2026

# Database Settings
DB_HOST=sanita-postgres
DB_PORT=5432
DB_USER=sanita_user
DB_PASSWORD=ReplaceWithStrongPassword2026!
DB_NAME=sanita
DB_SSLMODE=disable

